      "subject": "Welcome to Benzy Luxury",
      "htmlContent": "\n    <div style=\"margin:0;padding:32px 16px;background:#f6f0ea;font-family:Arial,Helvetica,sans-serif;color:#231711;\">\n      <div style=\"max-width:680px;margin:0 auto;background:#ffffff;border:1px solid #eadfd3;border-radius:16px;overflow:hidden;\">\n        <div style=\"padding:30px 32px 26px;background:#f6f0ea;color:#111111;text-align:center;border-bottom:1px solid #eadfd3;\">\n          <img src=\"https://raw.githubusercontent.com/Benzylux/Benzy-Luxury-Website/main/frontend/OFF%20BACK/BLX.png\" width=\"96\" alt=\"BLX\" style=\"display:block;width:96px;height:auto;margin:0 auto 14px;border:0;outline:none;text-decoration:none;\">\n          <div style=\"font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#6b5a4d;\">BENZY LUXURY</div>\n          <h1 style=\"margin:12px 0 0;font-size:30px;line-height:1.2;color:#111111;\">Welcome to Benzy Luxury</h1>\n        </div>\n        <div style=\"padding:32px;\">\n          <p style=\"margin:0 0 18px;font-size:16px;line-height:1.7;\">Hi {{ params.firstName | default:'there' }},</p>\n          <p style=\"margin:0 0 22px;font-size:16px;line-height:1.7;\">Your BLX account is ready. You can now manage orders, receipts, saved addresses, wishlist items, and notifications from your dashboard.</p>\n          \n  <p style=\"margin:0 0 18px;\">\n    <a href=\"{{ params.dashboardUrl }}\" style=\"display:inline-block;padding:14px 22px;border-radius:8px;background:#111111;color:#ffffff;text-decoration:none;font-weight:700;\">Open dashboard</a>\n  </p>\n\n          <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6b5a4d;\">Benzy Luxury<br>{{ params.supportEmail | default:'admin@benzyluxury.com' }}</p>\n        </div>\n      </div>\n    </div>\n  ",
      "id": 1,
      "action": "updated"
    },
